# Postgres connection strings (Supabase: Project Settings -> Database -> Connect -> ORMs tab)
# DATABASE_URL: shared transaction-mode pooler (IPv4) - used by the running app
DATABASE_URL=
# DIRECT_URL: shared session-mode pooler (IPv4) - used for migrations
# (Supabase's direct-connection host is IPv6-only, so pooler is used for both.)
DIRECT_URL=

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Admin auth session encryption key
# Random 32+ char string, e.g. `openssl rand -base64 32`
# (User accounts and roles are created via the web UI at /admin/setup on first run,
# then /admin/users afterward - no env var needed for them.)
SESSION_SECRET=
